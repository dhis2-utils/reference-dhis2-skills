{
  "_comment": "Synthetic export (GET /api/metadata?programs:filter=id:eq:PrgPerson01&...): the Person registration program's attributes and program rules. UIDs are made up.",
  "programs": [
    {
      "id": "PrgPerson01",
      "name": "Person registration",
      "programType": "WITH_REGISTRATION",
      "trackedEntityType": {"id": "TetPerson01"},
      "programTrackedEntityAttributes": [
        {"trackedEntityAttribute": {"id": "AtrDob00001"}, "mandatory": true,  "sortOrder": 1},
        {"trackedEntityAttribute": {"id": "AtrAge00001"}, "mandatory": false, "sortOrder": 2},
        {"trackedEntityAttribute": {"id": "AtrAgeGrp01"}, "mandatory": false, "sortOrder": 3},
        {"trackedEntityAttribute": {"id": "AtrSex00001"}, "mandatory": true,  "sortOrder": 4},
        {"trackedEntityAttribute": {"id": "AtrPreg0001"}, "mandatory": false, "sortOrder": 5},
        {"trackedEntityAttribute": {"id": "AtrConsnt01"}, "mandatory": false, "sortOrder": 6},
        {"trackedEntityAttribute": {"id": "AtrPhone001"}, "mandatory": false, "sortOrder": 7}
      ]
    }
  ],
  "trackedEntityAttributes": [
    {"id": "AtrDob00001", "name": "Date of birth", "valueType": "DATE"},
    {"id": "AtrAge00001", "name": "Age in years", "valueType": "INTEGER_ZERO_OR_POSITIVE"},
    {"id": "AtrAgeGrp01", "name": "Age group", "valueType": "TEXT", "optionSet": {"id": "OsAgeGrp001"}},
    {"id": "AtrSex00001", "name": "Sex", "valueType": "TEXT", "optionSet": {"id": "OsSex000001"}},
    {"id": "AtrPreg0001", "name": "Currently pregnant", "valueType": "BOOLEAN"},
    {"id": "AtrConsnt01", "name": "Consent to SMS reminders", "valueType": "TRUE_ONLY"},
    {"id": "AtrPhone001", "name": "Phone number", "valueType": "PHONE_NUMBER"}
  ],
  "optionSets": [
    {"id": "OsAgeGrp001", "name": "Age group", "valueType": "TEXT", "options": [{"id": "OptAgeChld1"}, {"id": "OptAgeAdlt1"}]},
    {"id": "OsSex000001", "name": "Sex", "valueType": "TEXT", "options": [{"id": "OptSexFem01"}, {"id": "OptSexMal01"}]}
  ],
  "options": [
    {"id": "OptAgeChld1", "code": "CHILD", "name": "Child (under 15)", "optionSet": {"id": "OsAgeGrp001"}},
    {"id": "OptAgeAdlt1", "code": "ADULT", "name": "Adult (15+)", "optionSet": {"id": "OsAgeGrp001"}},
    {"id": "OptSexFem01", "code": "F", "name": "Female", "optionSet": {"id": "OsSex000001"}},
    {"id": "OptSexMal01", "code": "M", "name": "Male", "optionSet": {"id": "OsSex000001"}}
  ],
  "programRuleVariables": [
    {"id": "PrvDob00001", "name": "dob", "program": {"id": "PrgPerson01"}, "programRuleVariableSourceType": "TEI_ATTRIBUTE", "trackedEntityAttribute": {"id": "AtrDob00001"}, "useCodeForOptionSet": false},
    {"id": "PrvAge00001", "name": "age", "program": {"id": "PrgPerson01"}, "programRuleVariableSourceType": "TEI_ATTRIBUTE", "trackedEntityAttribute": {"id": "AtrAge00001"}, "useCodeForOptionSet": false},
    {"id": "PrvSex00001", "name": "sex", "program": {"id": "PrgPerson01"}, "programRuleVariableSourceType": "TEI_ATTRIBUTE", "trackedEntityAttribute": {"id": "AtrSex00001"}, "useCodeForOptionSet": true},
    {"id": "PrvConsnt01", "name": "consent", "program": {"id": "PrgPerson01"}, "programRuleVariableSourceType": "TEI_ATTRIBUTE", "trackedEntityAttribute": {"id": "AtrConsnt01"}, "useCodeForOptionSet": false}
  ],
  "programRules": [
    {"id": "PrlAgeCalc1", "name": "Calculate age", "program": {"id": "PrgPerson01"}, "priority": 1,
     "condition": "d2:hasValue(#{dob})",
     "programRuleActions": [{"id": "PraAgeCalc1"}]},
    {"id": "PrlAgeChld1", "name": "Age group child", "program": {"id": "PrgPerson01"}, "priority": 2,
     "condition": "d2:hasValue(#{age}) && #{age} < 15",
     "programRuleActions": [{"id": "PraAgeChld1"}]},
    {"id": "PrlAgeAdlt1", "name": "Age group adult", "program": {"id": "PrgPerson01"}, "priority": 2,
     "condition": "d2:hasValue(#{age}) && #{age} >= 15",
     "programRuleActions": [{"id": "PraAgeAdlt1"}]},
    {"id": "PrlAgeHigh1", "name": "Warn on very high age", "program": {"id": "PrgPerson01"}, "priority": 3,
     "condition": "d2:hasValue(#{age}) && #{age} > 100",
     "programRuleActions": [{"id": "PraAgeHigh1"}]},
    {"id": "PrlPregMal1", "name": "Pregnancy not applicable for males", "program": {"id": "PrgPerson01"}, "priority": 4,
     "condition": "#{sex} == 'M'",
     "programRuleActions": [{"id": "PraPregHid1"}, {"id": "PraPregNo01"}]},
    {"id": "PrlPhoneMd1", "name": "Phone needed for SMS reminders", "program": {"id": "PrgPerson01"}, "priority": 5,
     "condition": "#{consent} == true",
     "programRuleActions": [{"id": "PraPhoneMd1"}]}
  ],
  "programRuleActions": [
    {"id": "PraAgeCalc1", "programRule": {"id": "PrlAgeCalc1"}, "programRuleActionType": "ASSIGN", "trackedEntityAttribute": {"id": "AtrAge00001"}, "data": "d2:yearsBetween(#{dob}, V{enrollment_date})"},
    {"id": "PraAgeChld1", "programRule": {"id": "PrlAgeChld1"}, "programRuleActionType": "ASSIGN", "trackedEntityAttribute": {"id": "AtrAgeGrp01"}, "data": "'CHILD'"},
    {"id": "PraAgeAdlt1", "programRule": {"id": "PrlAgeAdlt1"}, "programRuleActionType": "ASSIGN", "trackedEntityAttribute": {"id": "AtrAgeGrp01"}, "data": "'ADULT'"},
    {"id": "PraAgeHigh1", "programRule": {"id": "PrlAgeHigh1"}, "programRuleActionType": "SHOWWARNING", "trackedEntityAttribute": {"id": "AtrAge00001"}, "content": "Please check the date of birth. Age:", "data": "#{age}"},
    {"id": "PraPregHid1", "programRule": {"id": "PrlPregMal1"}, "programRuleActionType": "HIDEFIELD", "trackedEntityAttribute": {"id": "AtrPreg0001"}},
    {"id": "PraPregNo01", "programRule": {"id": "PrlPregMal1"}, "programRuleActionType": "ASSIGN", "trackedEntityAttribute": {"id": "AtrPreg0001"}, "data": "false"},
    {"id": "PraPhoneMd1", "programRule": {"id": "PrlPhoneMd1"}, "programRuleActionType": "SETMANDATORYFIELD", "trackedEntityAttribute": {"id": "AtrPhone001"}}
  ]
}
